# Mora & Solano — settings for Namecheap shared hosting (cPanel)

DirectoryIndex index.php index.html
Options -Indexes
ErrorDocument 404 /404.html

# --- Force HTTPS (activate the free SSL certificate in cPanel first; see README) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Clean addresses for the legal pages ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(aviso-legal|privacidad|terminos)/?$ legal.php?p=$1 [L,QSA]
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Never serve hidden or backup files ---
<FilesMatch "^\.|~$|\.(bak|old|orig|log|sql)$">
  Require all denied
</FilesMatch>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Browser caching for icons and photos ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
</IfModule>
